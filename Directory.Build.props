<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>

    <Version>2.0.0</Version>
    <Authors>Dominic Beger</Authors>
    <Copyright>Copyright © Dominic Beger 2015-2026</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dbforge/SharpMath</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dbforge/SharpMath</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>math;vector;matrix;geometry;linear-equations;expression-parser;plotting;canvas</PackageTags>
  </PropertyGroup>
</Project>
